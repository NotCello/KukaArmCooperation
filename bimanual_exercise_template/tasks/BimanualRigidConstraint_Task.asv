classdef BimanualRigidConstraint_Task < Task
    % Inequality task to keep the robot above a minimum altitude (Z > 0.15m)
    
    properties
        tL_T_o
        tR_T_o
        wTog
    end
    
    methods
        function obj = BimanualRigidConstraint_Task(robot_ID, taskID)
